{
  "name": "marble-circuit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -k -n server,web \"corepack pnpm --filter @marble/server dev\" \"corepack pnpm --filter @marble/web dev\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "corepack pnpm build && playwright test",
    "build": "corepack pnpm --filter @marble/web build && corepack pnpm --filter @marble/server build",
    "start": "node apps/server/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "prettier": "3.6.2",
    "socket.io-client": "4.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
